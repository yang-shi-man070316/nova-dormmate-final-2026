page{
  background:linear-gradient(180deg,#eef4ff 0%,#f7f8fa 100%);
  padding:30rpx;
}

.page{
  padding:20rpx;
}

.input-area{
  display:flex;
  align-items:center;
  background:#ffffff;
  border-radius:16rpx;
  padding:24rpx 30rpx;
  margin-bottom:20rpx;
  font-size:30rpx;
  box-shadow:0 4rpx 16rpx rgba(0,0,0,0.04);
}

.input-area text{
  color:#333;
  margin-right:10rpx;
}

input{
  flex:1;
  border:none;
  outline:none;
  font-size:30rpx;
  color:#333;
}

button.primary-btn{
  width:100%;
  background-color:#07c160;
  color:#ffffff;
  font-size:32rpx;
  font-weight:bold;
  border-radius:16rpx;
  padding:28rpx 0;
  margin:30rpx 0;
}

button.primary-btn::after{
  border:none;
}

.result-tip{
  background:#fff7e6;
  border-left:8rpx solid #faad14;
  border-radius:12rpx;
  padding:24rpx 30rpx;
  margin-bottom:30rpx;
}

.status-text{
  font-size:34rpx;
  color:#cf1322;
  font-weight:bold;
}

.advice-text{
  font-size:28rpx;
  color:#555;
  margin-top:10rpx;
}

.btn-group{
  display:flex;
  gap:20rpx;
  margin:30rpx 0;
}

.btn-group button{
  flex:1;
  background-color:#1677ff;
  color:#ffffff;
  font-size:28rpx;
  font-weight:bold;
  border-radius:12rpx;
  padding:22rpx 0;
  margin:0;
}

.btn-group button::after{
  border:none;
}

.card{
  background:#ffffff;
  border-radius:20rpx;
  padding:40rpx;
  margin-bottom:30rpx;
  box-shadow:0 8rpx 24rpx rgba(0,0,0,0.06);
}

.title{
  font-size:40rpx;
  font-weight:bold;
  text-align:center;
  color:#1677ff;
  margin-bottom:30rpx;
  letter-spacing:2rpx;
}

.line-item{
  font-size:30rpx;
  color:#333;
  margin-bottom:24rpx;
  display:flex;
  justify-content:space-between;
  padding:0 10rpx;
}

.chart-box{
  width:100%;
  height:420rpx;
  background:#fff;
  border-radius:20rpx;
  box-shadow:0 8rpx 24rpx rgba(0,0,0,0.06);
}